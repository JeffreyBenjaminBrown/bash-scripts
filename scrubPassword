#!/usr/bin/env bash
### USAGE
# Run
#   scrubPassword
# It asks for the password, shows everywhere it found it,
# and asks before changing anything.
#
### WHERE IT LOOKS
# Live tmux servers (every socket in the tmux socket directory):
#   - paste buffers containing the password   -> deleted
#   - panes whose scrollback contains it      -> scrollback cleared
#     (clear-history can't remove one line, only the whole history,
#     so it asks about this separately)
# On disk:
#   - everything under ~/.tmux/resurrect, including every server's
#     subfolder and the pane_contents.tar.gz archives
#   - your bash history file ($HISTFILE, or ~/.bash_history), plus any
#     leftover temp copies bash made of it ($HISTFILE-<pid>.tmp)
#   In files, every LINE containing the password is deleted.
#
### ORDER
# Live tmux state is cleaned first. Otherwise the next resurrect save
# (or continuum autosave) could write the password back to disk.
#
### SECURITY
# The password is never put on a command line, where `ps` could see it.
# It reaches grep through a process substitution (/dev/fd/N) that the
# printf builtin fills.

set -u

RESURRECT_DIR="$HOME/.tmux/resurrect"
HIST="${HISTFILE:-$HOME/.bash_history}"
SOCKET_DIR="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"

die() { echo "scrubPassword: ERROR: $*" >&2; exit 1; }

read -rsp "Password to scrub: " PW; echo
[ -n "$PW" ] || die "empty password."
# A very short string would match lots of innocent lines.
(( ${#PW} >= 6 )) || die "password shorter than 6 characters; refusing."

pw_pattern() { printf '%s\n' "$PW"; }
has_pw()     { grep -aqF -f <(pw_pattern) "$@"; }   # file args, or stdin
count_pw()   { grep -acF -f <(pw_pattern) "$1"; }

# Delete lines containing the password. Writing through `cat >`
# keeps the file's permissions and owner.
strip_file() {
  local f=$1 tmp
  tmp=$(mktemp) || return 1
  grep -avF -f <(pw_pattern) "$f" > "$tmp"
  cat "$tmp" > "$f"
  rm -f "$tmp"
}

strip_archive() {
  local a=$1 d f
  d=$(mktemp -d) || return 1
  if tar -xzf "$a" -C "$d"; then
    while IFS= read -r -d '' f; do
      has_pw "$f" && strip_file "$f"
    done < <(find "$d" -type f -print0)
    tar -czf "$a.new" -C "$d" . && mv "$a.new" "$a"
  else
    echo "scrubPassword: could not unpack $a; left alone." >&2
  fi
  rm -rf "$d"
}

### SEARCH
BUFFERS=()   # "socket|buffer"
PANES=()     # "socket|pane_id|description"
FILES=()
ARCHIVES=()

for s in "$SOCKET_DIR"/*; do
  [ -S "$s" ] || continue
  tmux -S "$s" list-sessions >/dev/null 2>&1 || continue
  while IFS= read -r b; do
    tmux -S "$s" show-buffer -b "$b" | has_pw && BUFFERS+=("$s|$b")
  done < <(tmux -S "$s" list-buffers -F '#{buffer_name}' 2>/dev/null)
  while read -r id where; do
    tmux -S "$s" capture-pane -p -J -S - -t "$id" | has_pw \
      && PANES+=("$s|$id|$where")
  done < <(tmux -S "$s" list-panes -a \
             -F '#{pane_id} #{session_name}:#{window_index}.#{pane_index}')
done

if [ -d "$RESURRECT_DIR" ]; then
  while IFS= read -r -d '' f; do
    case $f in
      *.tar.gz) tar -xzOf "$f" 2>/dev/null | has_pw && ARCHIVES+=("$f") ;;
      *)        has_pw "$f" && FILES+=("$f") ;;
    esac
  done < <(find "$RESURRECT_DIR" -type f -print0)
fi
for f in "$HIST" "$HIST"-*.tmp; do
  [ -f "$f" ] && has_pw "$f" && FILES+=("$f")
done

### REPORT
total=$(( ${#BUFFERS[@]} + ${#PANES[@]} + ${#FILES[@]} + ${#ARCHIVES[@]} ))
if (( total == 0 )); then
  echo "Not found anywhere I looked."
  unset PW; exit 0
fi

echo "Found the password in:"
for x in "${BUFFERS[@]}"; do
  IFS='|' read -r s b <<< "$x"
  echo "  tmux buffer $b (server $(basename "$s"))"
done
for x in "${PANES[@]}"; do
  IFS='|' read -r s id where <<< "$x"
  echo "  tmux pane $where (server $(basename "$s"))"
done
for f in "${FILES[@]}"; do
  echo "  $f ($(count_pw "$f") lines)"
done
for f in "${ARCHIVES[@]}"; do
  echo "  $f (archive)"
done
echo

### CLEAN: LIVE TMUX FIRST
for x in "${BUFFERS[@]}"; do
  IFS='|' read -r s b <<< "$x"
  tmux -S "$s" delete-buffer -b "$b"
done
(( ${#BUFFERS[@]} )) && echo "Deleted ${#BUFFERS[@]} tmux buffer(s)."

if (( ${#PANES[@]} )); then
  read -rp "Clear the ENTIRE scrollback of the panes listed above? [y/N] " a
  if [[ $a == [yY]* ]]; then
    for x in "${PANES[@]}"; do
      IFS='|' read -r s id where <<< "$x"
      tmux -S "$s" clear-history -t "$id"
    done
    echo "Cleared. If the password is still on the visible screen of"
    echo "any of those panes, run 'clear' there too."
  fi
fi

### CLEAN: DISK
if (( ${#FILES[@]} + ${#ARCHIVES[@]} )); then
  read -rp "Delete every line containing the password from the files above? [y/N] " a
  if [[ $a == [yY]* ]]; then
    for f in "${FILES[@]}";    do strip_file "$f";    done
    for f in "${ARCHIVES[@]}"; do strip_archive "$f"; done
    echo "Done."
  fi
fi

unset PW
echo
echo "Reminder: a bash shell where you typed the password still has it in"
echo "memory and writes it to $HIST when it exits. In such a shell, run"
echo "'history -c' before exiting, or run scrubPassword again afterward."
